  String _generateTopicName(String input) {
    final words = input
        .replaceAll(RegExp(r'[^a-zA-Z0-9 ]'), '')
        .split(' ')
        .where((w) => w.trim().isNotEmpty)
        .take(6)
        .map((w) => w[0].toUpperCase() + w.substring(1).toLowerCase())
        .toList();

    return words.join('_');
  }

